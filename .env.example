# Rho v2 — copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres@/rho?host=/tmp/pgembed-sock
ADMIN_API_KEY=change-me-admin
TICK_SECRET=change-me-tick

# Bolna (used in later batches)
BOLNA_API_KEY=
BOLNA_AGENT_ID_REACTIVATION=
BOLNA_AGENT_ID_REFERRAL=
BOLNA_WEBHOOK_SECRET=

# Safety: real outbound calls require DRY_RUN=0 AND phone in team_phones table
DRY_RUN=1
# Comma-separated E.164 or 10-digit numbers. Seeded idempotently into team_phones at startup.
# Prefer managing numbers via GET/POST/DELETE /admin/team-phones after first boot.
TEAM_PHONES=
# Deprecated alias: if set, also seeded into team_phones (same table). Prefer TEAM_PHONES.
TEST_PHONE_ALLOWLIST=

INR_PER_USD=88
DEV=0
WORKER_ENABLED=1
TICK_INTERVAL_SECONDS=60

# Extra CORS origins (comma-separated). Base regex always allows
# https://astro-naut.github.io, https://rho-for-bolna.vercel.app, localhost, 127.0.0.1
CORS_EXTRA_ORIGINS=

# In-memory token bucket (per IP). refill_rate tokens/sec, capacity burst.
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1.0

# Optional Bolna API base (default https://api.bolna.ai)
BOLNA_API_BASE=https://api.bolna.ai
